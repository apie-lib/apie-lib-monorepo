{
  "name": "apie/serializer",
  "description": "Composer package of the apie library: serializer",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Pieter Jordaan",
      "email": "pieter_jordaan@hotmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Apie\\Serializer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Apie\\Tests\\Serializer\\": "tests/"
    }
  },
  "extra": {
    "apie-objects": [
    "Apie\\Serializer\\Lists\\NormalizerList",
    "Apie\\Serializer\\Lists\\SerializedList",
    "Apie\\Serializer\\Lists\\SerializedHashmap",
    "Apie\\Serializer\\ValueObjects\\SerializedPhpObject",
    "Apie\\Serializer\\DecoderHashmap",
    "Apie\\Serializer\\EncoderHashmap",
    "Apie\\Serializer\\PropertySerializer\\TypeDefinition",
    "Apie\\Serializer\\PropertySerializer\\TypehintMap"
]
  },
  "require": {
    "php": ">=8.3",
    "apie/core": "self.version",
    "apie/type-converter": "^1.6.2",
    "opis/closure": "^4.5.0",
    "psr/http-message": "^1.1|^2.0",
    "symfony/http-foundation": "^7.2"
  },
  "require-dev": {
    "apie/common-value-objects": "self.version",
    "apie/fixtures": "self.version",
    "apie/service-provider-generator": "0.14.0",
    "apie/text-value-objects": "self.version",
    "illuminate/support": "*",
    "nyholm/psr7": "^1.8.2",
    "phpunit/phpunit": "^11.5.2",
    "phpspec/prophecy-phpunit": "^2.2"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}