{{ component('filterColumns') }}
{% set variantClasses = {
  'primary': 'border-green-500 bg-green-300 text-green-900 hover:bg-green-200',
  'secondary': 'border-blue-500 bg-blue-300 text-blue-900 hover:bg-blue-200',
  'danger': 'border-red-500 bg-red-400 text-white hover:bg-red-500',
  'plain': 'border-slate-300 bg-white text-slate-800 hover:bg-slate-100',
  'default': 'border-yellow-400 bg-yellow-200 text-yellow-900 hover:bg-yellow-100'
} %}
<div class="my-4 flex flex-wrap gap-3">
{% for action in property('actions') %}
  <a class="wiggle inline-flex items-center gap-2 rounded-2xl border-3 px-4 py-2 font-black shadow-md transition-colors {{ variantClasses[action.getVariant().value] ?? variantClasses.default }}" href="{{ action.getUrl(property('config')) }}"{% if action.isSmallPage() %} data-small-page="true" onclick="return openSmallPage(this, event)"{% endif %}>
    {{ action.name }}
  </a>
{% endfor %}
</div>
