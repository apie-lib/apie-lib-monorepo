{
  "name": "apie/maker",
  "description": "Composer package of the apie library: maker",
  "type": "library",
  "license": "MIT",
  "config": {
    "allow-plugins": {
        "apie/apie-common-plugin": true
    }
  },
  "authors": [
    {
      "name": "Pieter Jordaan",
      "email": "pieter_jordaan@hotmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Apie\\Maker\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Apie\\Tests\\Maker\\": "tests/"
    }
  },
  "extra": {
    "apie-objects": [
    "Apie\\Maker\\Dtos\\DomainObjectDto",
    "Apie\\Maker\\BoundedContext\\Dtos\\PropertyDefinition",
    "Apie\\Maker\\BoundedContext\\Lists\\PropertyDefinitionList",
    "Apie\\Maker\\BoundedContext\\Identifiers\\BoundedContextDefinitionIdentifier",
    "Apie\\Maker\\BoundedContext\\Identifiers\\ResourceDefinitionIdentifier",
    "Apie\\Maker\\BoundedContext\\Identifiers\\CodeGeneratedLogIdentifier",
    "Apie\\Maker\\Enums\\NullableOption",
    "Apie\\Maker\\Enums\\PrimitiveType",
    "Apie\\Maker\\Enums\\IdType",
    "Apie\\Maker\\Enums\\OverwriteStrategy",
    "Apie\\Maker\\ValueObjects\\PropertyDefinitionName",
    "Apie\\Maker\\ValueObjects\\ClassNameReference",
    "Apie\\Maker\\ValueObjects\\VendorValueObject"
]
  },
  "conflict": {
    "nette/utils": "3.*"
  },
  "require": {
    "php": ">=8.4",
    "apie/apie-common-plugin": "self.version",
    "apie/common": "self.version",
    "apie/core": "self.version",
    "haydenpierce/class-finder": "0.5.3",
    "nette/php-generator": "^4.2.2",
    "nikic/php-parser": "^5.8.0",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "apie/fixtures": "self.version",
    "apie/service-provider-generator": "0.14.0",
    "beste/clock": "^3.0",
    "illuminate/support": "*",
    "phpunit/phpunit": "^11.5.2",
    "phpspec/prophecy-phpunit": "^2.5",
    "symfony/event-dispatcher": "^7.2"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}