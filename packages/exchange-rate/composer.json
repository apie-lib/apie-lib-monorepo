{
  "name": "apie/exchange-rate",
  "description": "Composer package of the apie library: exchange rate",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Pieter Jordaan",
      "email": "pieter_jordaan@hotmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Apie\\ExchangeRate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Apie\\Tests\\ExchangeRate\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "apie/core": "self.version",
    "symfony/http-client": "^7.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5.2",
    "phpspec/prophecy-phpunit": "^2.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}