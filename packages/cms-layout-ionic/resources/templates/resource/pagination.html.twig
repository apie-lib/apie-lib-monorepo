<div>
    <div>
        Shown {{ property('shownCount') }} of {{ property('totalCount') }}
    </div>
    <div>
        {% for i in range(1, (property('totalCount') / property('pageSize'))|round(0, 'ceil')) %}
            <ion-button 
              style="height: 2.5rem; width: 2.5rem; padding: 0; line-height: 1; --padding-start: 0; --padding-end: 0;" 
              onclick="location.href = location.protocol + '//' + location.host + location.pathname + {{ property('querySearch').withPageIndex(i - 1).toHttpQuery() | safe_json_encode | replace({'"': "'"}) }};" size="small">{{ i }}</ion-button>
        {% endfor %}
    </div>
</div>
