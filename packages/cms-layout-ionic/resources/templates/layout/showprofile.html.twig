{% set fields = property('fields') %}
{% set username = fields.username ?? fields.fullName ?? fields.name ?? fields.lastName ?? fields.firstName ?? fields.email ?? 'user'  %}

<ion-avatar class="account-avatar" {% if not property('simple') %} slot="start"{% endif %}>
    <img src="{{ property('gravatarUrl') }}?s=34&amp;d=mp">

  </ion-avatar>
  {% if property('simple') %}
      {{  username }}
  {% else %}
      <ion-label>
          <h2>{{ username }}</h2>
          <p>Logged in</p>
      </ion-label>
  {% endif %}


