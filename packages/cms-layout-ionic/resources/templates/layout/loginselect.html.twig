{% set hasDropdown = property('loginOptions')|length or property('profileUrl') or property('logoutUrl') %}
<ion-button id="quick-form">

    <ion-icon
            slot="start"
            name="create-outline">
    </ion-icon>

    Form

</ion-button>

{% if hasDropdown or property('authenticated') %}
<ion-button{% if hasDropdown %} id="account"{% endif %} fill="clear">
    {% if (property('authenticated')) %}
    {{ component('profile') }}
    {% else %}
        <ion-avatar></ion-avatar> Unauthenticated
    {% endif %}
    {% if hasDropdown %}
    <ion-icon
            slot="end"
            name="chevron-down-outline">
    </ion-icon>
    {% endif %}
</ion-button>
{% endif %}

<script type="module">
    import {
        menuController,
        popoverController
    }
        from
            "https://cdn.jsdelivr.net/npm/@ionic/core@latest/dist/ionic/index.esm.js";



    document
        .querySelector("#quick-form")
        .addEventListener(
            "click",
            ()=>menuController.open("right-panel")
        );
    {% if hasDropdown %}
    class AccountPopover extends HTMLElement {


        connectedCallback() {
{% set html %}
            <ion-list>
                <ion-item lines="none">
                    {% if (property('authenticated')) %}
                    {{ component('profileDetails') }}
                    {% else %}
                    You are not logged in
                    {% endif %}
                </ion-item>
                {% if property('profileUrl') %}
                <ion-item button data-url="{{ property('profileUrl') }}" onClick="location.href=this.dataset.url">
                    <ion-icon
                        slot="start"
                        name="person-circle-outline">
                    </ion-icon>
                    Show Profile
                </ion-item>
                <hr />
                {% endif %}
                {% for loginOption in property('loginOptions') %}
                    <ion-item button data-url="{{ loginOption.value }}" onClick="location.href=this.dataset.url">

                        <ion-icon
                            slot="start"
                            name="log-in-outline">
                        </ion-icon>

                        {{  loginOption.name }}

                    </ion-item>
                {% endfor %}
                 {% if property('logoutUrl') %}
                    <hr />
                    <ion-item button data-url="{{ property('logoutUrl') }}" onClick="location.href=this.dataset.url">
                        <ion-icon
                            slot="start"
                            name="log-out-outline">
                        </ion-icon>
                        Logout
                    </ion-item>
                {% endif %}
            </ion-list>
{% endset %}

            this.innerHTML = {{ html | safe_json_encode }};
        }
    }


    customElements.define(
        "account-popover",
        AccountPopover
    );





    document
        .querySelector("#account")
        .addEventListener(
            "click",
            async(event)=>{


                const pop =
                    await popoverController.create({

                        component:"account-popover",

                        event:event,

                        alignment:"end"

                    });


                await pop.present();


            });
    {% endif %}


</script>