{
  "name": "apie/typescript-code-builder",
  "description": "Composer package of the apie library: typescript code builder",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Pieter Jordaan",
      "email": "pieter_jordaan@hotmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Apie\\TypescriptCodeBuilder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Apie\\Tests\\TypescriptCodeBuilder\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "apie/core": "self.version"
  },
  "require-dev": {
    "apie/fixtures": "self.version",
    "phpunit/phpunit": "^11.5.2",
    "phpspec/prophecy-phpunit": "^2.5"
  },
  "extra": {
    "apie-objects": [
